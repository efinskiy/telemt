limit_req_zone $binary_remote_addr zone=admin_login:1m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=admin_connections:1m;
server {
    listen 80;
    server_name ${ADMIN_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${ADMIN_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    client_header_timeout 5s;
    client_body_timeout 10s;
    keepalive_timeout 30s;
    limit_conn admin_connections 32;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log off;
    location = /api/login {
        limit_req zone=admin_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://admin:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }
    location / {
        proxy_pass http://admin:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }
}
