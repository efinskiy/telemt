ADMIN_DOMAIN=admin.example.org
ADMIN_UID=10001
ADMIN_GID=10001
NODE_CONFIG_DIR=/etc/telemt
PROBE_REFERENCE_URL=https://independent-reference.example.org/
TELEMT_IMAGE_PREFIX=ghcr.io/efinskiy/telemt
# Pin sha-<full commit SHA> for reproducible deployments after publication.
TELEMT_IMAGE_TAG=main

# Required for all Fleet node enrollment. Use an immutable GHCR digest.
# Resolve the digest after publishing the managed-node image; do not use a main tag here.
# MANAGED_NODE_IMAGE=ghcr.io/efinskiy/telemt-managed-node@sha256:<published manifest digest>
MANAGED_NODE_IMAGE=
